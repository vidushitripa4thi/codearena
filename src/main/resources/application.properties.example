spring.application.name=codearena

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Replace these values or export environment variables:
#   DB_URL (default: jdbc:postgresql://localhost:5432/codearena)
#   DB_USERNAME (default: postgres)
#   DB_PASSWORD (required)
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/codearena}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_database_password_here}

# ==============================================================================
# JPA / Hibernate Configuration
# ==============================================================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ==============================================================================
# JWT Security Configuration
# ==============================================================================
# Generate a secure random secret of at least 32 characters (256 bits):
# Linux/macOS: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
app.jwt.secret=${JWT_SECRET:your_secure_random_jwt_secret_key_at_least_32_characters}
app.jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES:60}

# ==============================================================================
# Database Seeding & Initial Admin Configuration (Development)
# ==============================================================================
# SEED_DATA: Enable/disable seeding of initial coding problems (default: true)
app.seed.enabled=${SEED_DATA:true}

# Optional Initial Admin Bootstrap:
# Supply environment variables to bootstrap an initial ADMIN account safely in dev.
# If omitted or left empty, no default admin is created.
app.admin.username=${ADMIN_USERNAME:}
app.admin.email=${ADMIN_EMAIL:}
app.admin.password=${ADMIN_PASSWORD:}

