# ==============================================================================
# DeployForge Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    Windows PowerShell: Copy-Item .env.example .env
#    Linux / macOS:      cp .env.example .env
# 2. Update placeholder values with your custom credentials.
# 3. Never commit the actual .env file to version control (enforced in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_DB=codearena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_strong_postgres_password
# Host port mapping for PostgreSQL. Note: if port 5432 is reserved by
# Windows or a local PostgreSQL instance, change to 5433.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend Service & Security Settings
# ------------------------------------------------------------------------------
BACKEND_PORT=8080

# Minimum 256 bits (32 characters) HMAC-SHA256 secret key for signing JWTs.
# Generate a cryptographically strong random secret using:
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Linux / macOS:      openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_base64_secret_minimum_32_characters
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# Database Seeder & Administrator Bootstrap (Development)
# ------------------------------------------------------------------------------
SEED_DATA=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@codearena.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ------------------------------------------------------------------------------
# Frontend & Nginx Port Mapping
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
